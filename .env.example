# LLM API key for OpenAI, Anthropic, or Gemini. Keep the placeholder for offline writing.
LLM_API_KEY="sk-your-provider-key"
# xAI has a separate key; the application executes Grok tool calls through its own guarded registry.
XAI_API_KEY=""
# Provider name: openai, anthropic, gemini, ollama, or xai.
LLM_PROVIDER="openai"
# Model name understood by the selected provider.
LLM_MODEL="gpt-4o-mini"
# Optional OpenAI-compatible endpoint, or Ollama's base URL.
LLM_BASE_URL=""
# Runtime environment controls production-only validation.
ENVIRONMENT="development"
# OIDC issuer and confidential client. Register this exact callback URL with the IdP.
# Google is the default OIDC provider; replace it if you use another OIDC issuer.
OIDC_ISSUER_URL="https://accounts.google.com"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost/api/v1/auth/callback"
# Comma-separated verified email allowlist. Leave empty only when explicitly enabling open sign-up below.
OIDC_ALLOWED_EMAILS=""
# Allow any account from the configured OIDC issuer. Keep false unless public registration is intended.
OIDC_ALLOW_ANY_EMAILS="false"
# Required only when migrating existing unowned tasks.
OIDC_BOOTSTRAP_EMAIL=""
# Random signing key for OIDC state/nonce/PKCE transient session.
OIDC_SESSION_SECRET=""
SESSION_COOKIE_SECURE="false"
# Random secret of at least 32 characters. Handoff derives its AES-GCM key from this value.
APP_ENCRYPTION_KEY=""
# PostgreSQL URL. Container hostnames are used by Compose.
DATABASE_URL="postgresql://user:password@db:5432/agent_db"
# PostgreSQL container password. Keep it aligned with DATABASE_URL and change it in production.
POSTGRES_PASSWORD="password"
# Redis database 0 stores scratchpad and status events.
REDIS_URL="redis://redis:6379/0"
# Celery broker URL. Use a distinct Redis database from task data.
CELERY_BROKER_URL="redis://redis:6379/1"
# Celery result backend URL.
CELERY_RESULT_BACKEND="redis://redis:6379/2"
# API port published by the local Compose stack.
API_PORT="8000"
# Number of Uvicorn API processes; keep at 1 for small instances.
API_WORKERS="1"
# Workflow engine: temporal (default) or celery_langgraph.
WORKFLOW_ENGINE="temporal"
# Temporal target. Local Compose uses temporal:7233; production uses Temporal Cloud.
TEMPORAL_ADDRESS="temporal:7233"
# Optional Temporal namespace and API key (Cloud).
TEMPORAL_NAMESPACE="default"
TEMPORAL_API_KEY=""
# CORS allowlist. Use comma-separated origins; keep empty for same-origin-only deployments.
CORS_ORIGINS=""
# Application log level.
LOG_LEVEL="INFO"
# Rate-limit window and maximum submissions per signed-in user.
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="30"
# Demo tasks are disabled by default so synthetic content is never presented as live research.
SEED_DEMO_DATA="false"
# Private SearXNG service URL, or a separately operated instance that enables JSON results.
SEARXNG_URL="http://searxng:8080"
# Used by the private SearXNG service to sign internal state.
SEARXNG_SECRET="replace-with-a-random-secret"
# Optional separately operated Crawl4AI service for JavaScript-heavy sources.
CRAWL4AI_URL=""
RESEARCH_MAX_QUERIES="3"
RESEARCH_MAX_RESULTS="8"
RESEARCH_MAX_PAGES="5"
RESEARCH_MAX_BYTES="1000000"
RESEARCH_TIMEOUT_SECONDS="12"
RESEARCH_MAX_TOOL_CALLS="12"
# Celery bridge and API worker probe timeout in seconds.
CELERY_PROBE_TIMEOUT_SECONDS="1.5"
# Maximum request body bytes accepted by the API.
MAX_REQUEST_BYTES="65536"
# Domain served by Caddy. Set to a DNS name in production.
DOMAIN="localhost"
# Service label used in health and status responses.
APP_VERSION="0.1.0"
